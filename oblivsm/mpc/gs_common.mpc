# State, input/output and the proposal sweep shared by Algorithms 3 and 4.
# Party 0 inputs the suitors' score matrix, party 1 the reviewers' (one row per person).

class OSMState(object):
    def __init__(self, n):
        self.n = n
        self.ps = sint.Matrix(n, n)   # suitor i's score for reviewer j
        self.pr = sint.Matrix(n, n)   # reviewer i's score for suitor j
        self.s_m = sint.Array(n)      # suitor's current match
        self.s_p = sint.Array(n)      # suitor's score for it
        self.r_m = sint.Array(n)      # reviewer's current match
        self.r_p = sint.Array(n)      # reviewer's score for it
        self.u_s = sint.Array(n)      # 1 if suitor is unmatched
        self.s_m.assign_all(sint(BOT))
        self.s_p.assign_all(sint(BOT))
        self.r_m.assign_all(sint(BOT))
        self.r_p.assign_all(sint(BOT))
        self.u_s.assign_all(sint(1))

    def read_inputs(self):
        n = self.n

        @for_range(n)
        def _(i):
            self.ps[i] = sint.get_input_from(0, size=n)

        @for_range(n)
        def _(i):
            self.pr[i] = sint.get_input_from(1, size=n)

    def shift_scores_down(self):
        """Partial lists: input files hold score+1 (0 = unacceptable); make that -1."""
        n = self.n

        @for_range(n)
        def _(i):
            for k in range(n):
                self.ps[i][k] = self.ps[i][k] - 1
                self.pr[i][k] = self.pr[i][k] - 1

    def reveal_matching(self):
        n = self.n

        @for_range(n)
        def _(i):
            print_ln('OBLIVSM_SUITOR %s %s', i, self.s_m[i].reveal())

        @for_range(n)
        def _(i):
            print_ln('OBLIVSM_REVIEWER %s %s', i, self.r_m[i].reveal())


def proposal_sweep(st):
    """One pass over all suitors; every update is a conditional assignment."""
    n = st.n

    @for_range(n)
    def _(j):
        u_disp = sint(BOT)         # suitor displaced by j's new match
        r_prop = sint(BOT)         # reviewer j ends up with
        t_m = sint(BOT)            # that reviewer's new partner
        t_p = sint(BOT)            # and her score for him
        u_m = st.u_s[j]
        cur_m = st.s_m[j]
        cur_p = st.s_p[j]
        cur_u = st.u_s[j]

        for k in range(n):
            c = (secure_lt(cur_p, st.ps[j][k])
                 * secure_lt(st.r_p[k], st.pr[k][j])
                 * u_m)
            u_disp = cond_assign(c, st.r_m[k], u_disp)
            cur_m = cond_assign(c, k, cur_m)
            cur_p = cond_assign(c, st.ps[j][k], cur_p)
            cur_u = cond_assign(c, 0, cur_u)
            r_prop = cond_assign(c, k, r_prop)
            t_m = cond_assign(c, j, t_m)
            t_p = cond_assign(c, st.pr[k][j], t_p)

        st.s_m[j] = cur_m
        st.s_p[j] = cur_p
        st.u_s[j] = cur_u

        for z in range(n):
            c = secure_eq(u_disp, z)
            st.u_s[z] = cond_assign(c, 1, st.u_s[z])
            st.s_m[z] = cond_assign(c, BOT, st.s_m[z])
            st.s_p[z] = cond_assign(c, BOT, st.s_p[z])

        for z in range(n):
            c = secure_eq(r_prop, z)
            st.r_m[z] = cond_assign(c, t_m, st.r_m[z])
            st.r_p[z] = cond_assign(c, t_p, st.r_p[z])
