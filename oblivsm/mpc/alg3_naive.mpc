# Algorithm 3: naive oblivious Gale-Shapley (fixed number of sweeps).
# Compile args: <n> [sweeps]   (default sweeps = n, as in the paper)

n = int(program.args[1])
sweeps = int(program.args[2]) if len(program.args) > 2 else n

st = OSMState(n)
st.read_inputs()

@for_range(sweeps)
def _(i):
    proposal_sweep(st)

st.reveal_matching()
